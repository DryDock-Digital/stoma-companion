# Backend base URL. Leave unset to run the fully self-contained DEMO flow
# (simulated progress + a sample result) — handy for design review and investors.
# Set it to talk to the real service, e.g. http://143.244.169.119:8000
VITE_API_BASE=

# Force the simulated flow even when VITE_API_BASE is set.
VITE_SIMULATE=
