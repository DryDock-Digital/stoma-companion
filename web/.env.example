# Backend base URL. Leave unset to run the fully self-contained DEMO flow
# (simulated progress + a sample result) — handy for design review and investors.
# Set it to talk to the real service, e.g. https://159-65-233-200.sslip.io
# NOTE: the app is served over https, so the backend must be https too — a plain
# http:// backend is blocked by the browser as mixed content.
VITE_API_BASE=

# Force the simulated flow even when VITE_API_BASE is set (demo only).
# When VITE_API_BASE is set and this is unset, the app never simulates.
VITE_SIMULATE=
