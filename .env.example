# Stoma Companion — environment template (P0-7)
# Copy to `.env` (root), `backend/.env`, and/or `worker-colmap/.env` as needed.
# Never commit real values — `.env*` is gitignored except this file.

# --- Supabase (backend + workers) ------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
# Backend + workers use the service-role key (bypasses RLS). Server-side only —
# never ship this to a browser/Capacitor client.
SUPABASE_SERVICE_ROLE_KEY=
# Anon/publishable key, for any future client-side use. Not needed server-side.
SUPABASE_ANON_KEY=
# Storage bucket for videos/keyframes/meshes.
SUPABASE_STORAGE_BUCKET=scans

# --- Backend API -----------------------------------------------------------
# Max upload size accepted by POST /scans, in megabytes.
MAX_UPLOAD_MB=512
# Keyframe extraction defaults (ported from legacy VideoFrameExporter).
KEYFRAME_INTERVAL_SECONDS=0.35
KEYFRAME_MAX_FRAMES=350
# Measurement knobs — stamped onto every job's config at upload (reproducible runs).
# Grace ring offset around the outline, mm (FR-07 — configurable, never hard-coded).
GRACE_RING_MM=3.0
# Dimensional tolerance, mm (FR-09).
TOLERANCE_MM=1.0
# Printed ArUco card edge length, mm, and dictionary.
MARKER_SIDE_MM=50.0
ARUCO_DICT=DICT_4X4_50
# G-code dialect: grbl (P4 simulator/GRBL controllers) | stoma-plotter (legacy firmware).
GCODE_DIALECT=grbl
# Run the keyframe stage inside the API process (1) or as `python -m app.keyframe_worker` (0).
RUN_KEYFRAME_WORKER=1
# Queue robustness: a claim older than this is requeued; after MAX_ATTEMPTS it fails.
CLAIM_TIMEOUT_S=1800
MAX_ATTEMPTS=2
# Hard wall-clock bounds per stage (safety, not the FR-11 target).
RECONSTRUCT_TIMEOUT_S=1800
MEASURE_TIMEOUT_S=300
# CORS origins for the web/Capacitor app (comma-separated). "*" for the demo phase.
CORS_ORIGINS=*

# --- Reconstruction worker -------------------------------------------------
# Opaque id so the API can attribute/claim jobs and report worker-offline later.
WORKER_ID=colmap-1
# Seconds between queue polls.
WORKER_POLL_INTERVAL=5

# --- DigitalOcean (provisioning only; not read by the app) -----------------
# Used by infra/digitalocean scripts. Keep out of the app runtime env.
DIGITALOCEAN_ACCESS_TOKEN=

# --- Droplet deploy target (used by infra/deploy.sh; not read by the app) --
# infra/deploy.sh ships ONLY the Supabase/app keys above to the droplet — never
# these lines. DROPLET_SSH_KEY must be a passphrase-less key authorized on the box.
DROPLET_HOST=
DROPLET_USER=root
DROPLET_SSH_KEY=~/.ssh/stoma_droplet
